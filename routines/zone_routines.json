{
  "description": "Per-zone encounter and combat routine configuration for Pink Dots and Yellow Orbit Zones. Edit steps and timings individually per zone.",
  "pink_zones": {
    "pink_1": {
      "name": "Pink Dot #1 (WP #8)",
      "description": "First encounter banner / sims",
      "steps": [
        {
          "action": "stop",
          "duration": 2.5,
          "description": "Halt character movement"
        },
        {
          "action": "detect_and_click_sims",
          "priority": ["sim1", "sim3", "sim2"],
          "click_y_offset": 35,
          "click_x_offset": 0,
          "approach_wait": 2.0,
          "description": "Attempt to detect and select sim banners with approach wait"
        },
        {
          "action": "click_encounter_banner",
          "approach_wait": 2.0,
          "reclick": false,
          "search_attempts": 5,
          "description": "Fallback banner click if no sims detected"
        },
        {
          "action": "click_mouse",
          "button": "right",
          "clicks": 1,
          "delay": 0.15,
          "description": "Single right-click skill"
        },
        {
          "action": "hold_mouse",
          "button": "middle",
          "duration": 4.0,
          "description": "Hold middle mouse button for 4.0 seconds"
        },
        {
          "action": "orbit_yellow_zone",
          "duration": 50.0,
          "right_click_interval": 0.75,
          "description": "Orbit inside yellow zone for 50s"
        },
        {
          "action": "pickup_loot",
          "max_items": 15,
          "pickup_delay": 0.4,
          "approach_wait": 1.5,
          "wait_for_green_light": true,
          "description": "Collect loot with approach wait and wait for manual green light confirmation"
        }
      ]
    },
