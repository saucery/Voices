{
  "description": "Per-zone encounter and combat routine configuration for Pink Dots and Yellow Orbit Zones. Edit steps and timings individually per zone.",
  "pink_zones": {
    "pink_1": {
      "name": "Pink Dot #1 (WP #7 - Room 1)",
      "description": "First encounter banner / sims / orbit / loot",
      "steps": [
        {
          "action": "stop",
          "duration": 2.5,
          "description": "Halt character movement"
        },
        {
          "action": "navigate_to_pink_location",
          "timeout": 8.0,
          "arrival_threshold": 15.0,
          "description": "Walk back to encounter banner (pink dot)"
        },
        {
          "action": "click_encounter_banner",
          "approach_wait": 2.0,
          "reclick": false,
          "search_attempts": 5,
          "activate_combat": false,
          "description": "Click encounter banner to start encounter"
        },
        {
          "action": "navigate_to_pink_location",
          "timeout": 8.0,
          "arrival_threshold": 15.0,
          "description": "Position character on pink dot before combat"
        },
        {
          "action": "hold_key",
          "key": "q",
          "duration": 1.6,
          "min_hold_seconds": 1.6,
          "max_hold_seconds": 1.6,
          "pre_cast_button": "left",
          "pre_cast_interval": 4.0,
          "follow_up_key": "r",
          "follow_up_delay": 2.0,
          "click_offset": [
            60,
            40
          ],
          "combat_interval": 0.65,
          "combat_action": "key",
          "combat_key": "t",
          "right_click_interval": 0.65,
          "description": "Click left mouse near character (frost bomb), wait 2s, press 'R', retry every 4s until enemies detected, then hold 'Q' for 1.6s and start orbiting with 'T'"
        },
        {
          "action": "orbit_yellow_zone",
          "duration": 50.0,
          "right_click_interval": 0.65,
          "rolling_enabled": true,
          "rolling_interval": 2.0,
          "description": "Orbit inside yellow zone for 50s"
        },
        {
          "action": "navigate_to_loot_location",
          "timeout": 10.0,
          "arrival_threshold": 15.0,
          "description": "Walk to LOOT location (white dot)"
        },
        {
          "action": "pickup_loot",
          "max_items": 15,
          "pickup_delay": 1,
          "approach_wait": 1.1,
          "wait_for_green_light": false,
          "description": "Collect loot with approach wait and wait for manual green light confirmation"
        }
      ]
    },
